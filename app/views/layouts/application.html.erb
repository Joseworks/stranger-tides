<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <title>Stranger Tides</title>
    <meta name="application-name" content="Stranger Tides">
    <meta name="apple-mobile-web-app-title" content="Stranger Tides">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="description" content="<%= ui("Explore NOAA water levels, tide predictions, and station weather with Stranger Tides.") %>">
    <%= favicon_link_tag 'favicon_jw.ico' %>
    <%= include_gon if defined?(Gon) %>
    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track' => true %>
    <script id="app-i18n" type="application/json"><%= raw json_escape({ locale: I18n.locale, messages: I18n.t('messages', default: {}) }.to_json) %></script>
    <%= javascript_include_tag 'application', 'data-turbolinks-track' => true %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>

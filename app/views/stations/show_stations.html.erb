<header id="header">
  <a href="/" class="brand">Stranger Tides</a>
  <p>NOAA water levels, tide predictions &amp; station conditions</p>
</header>
<main id="station-explorer">
  <section class="discovery" aria-label="Find stations">
    <label for="station-search">Find a station</label>
    <input id="station-search" type="search" placeholder="Name, station ID, or state" autocomplete="off">
    <label for="station-layer">Show stations</label>
    <select id="station-layer">
      <option value="waterlevels">Active water-level stations</option>
      <option value="tidepredictions">Tide prediction locations</option>
      <option value="waterlevelsandmet">Water-level &amp; weather stations</option>
      <option value="additional">Matching highlighted product</option>
      <option value="all">All locations</option>
    </select>
    <label for="station-product">Highlight product</label>
    <select id="station-product" aria-describedby="product-status">
      <option value="specialized" selected>Specialized sensors</option>
      <option value="ofs_water_level">Water-level forecast</option>
      <option value="flood_outlook">Flood outlook</option>
      <option value="salinity">Salinity</option>
      <option value="conductivity">Conductivity</option>
      <option value="visibility">Visibility</option>
      <option value="air_gap">Bridge clearance</option>
      <option value="one_minute_water_level">One-minute water levels</option>
      <option value="any">Any additional product</option>
    </select>
    <p id="product-status" class="muted" aria-live="polite"></p>
    <p id="catalog-status" class="muted" role="status">Loading station catalog…</p>
    <button id="locate" type="button" aria-describedby="location-details">Find stations near me</button>
    <p id="location-details" class="muted">Location request from <span id="location-origin"><%= request.host_with_port %></span> to find nearby stations and center the Google map.</p>
    <p id="location-status" class="muted" role="status"></p>
    <p id="result-count" aria-live="polite"></p>
    <ul id="station-results" aria-label="Station results"></ul>
    <button id="more-stations" type="button" hidden>Show more stations</button>
  </section>
  <section class="map-section" aria-label="Station map">
    <p id="map-status" class="muted" role="status">Loading map. You can also use the station list.</p>
    <p class="map-legend">Each pin is one station. Tap overlapping pins to spread them out without zooming. <span class="station-swatch" aria-hidden="true"></span> Orange pin = other stations. <span class="station-swatch extra-swatch" aria-hidden="true"></span> <span id="highlight-legend">Purple pin = specialized sensors.</span> <button id="extra-products-toggle" type="button" aria-pressed="false">Show matching stations only</button></p>
    <div id="full_map" data-marker-icon="<%= asset_path('orange_marker.png') %>"
         data-extra-marker-icon="<%= asset_path('purple_marker.svg') %>"
         data-maps-key="<%= ENV['STRANGER_TIDES_EMBED_MAPS_API_KEY'] %>"
         data-map-id="<%= ENV['STRANGER_TIDES_MAP_ID'] %>"></div>
  </section>
  <section id="station-panel" aria-labelledby="station-heading" hidden>
    <div class="panel-heading">
      <h1 id="station-heading" tabindex="-1" aria-live="polite">Station details</h1>
      <button id="close-station" type="button" aria-label="Close station details">Close</button>
    </div>
    <div class="chart-controls">
      <label>History <select id="history-hours" aria-label="History"><option value="24">24 hours</option><option value="48" selected>48 hours</option><option value="72">72 hours</option><option value="168">7 days</option><option value="720">30 days</option></select></label>
      <label>Plan ahead <select id="future-hours" aria-label="Plan ahead"><option value="0">Off</option><option value="24">24 hours</option><option value="72">3 days</option><option value="168" selected>7 days</option><option value="720">30 days</option></select></label>
      <label>Units <select id="height-units" aria-label="Units"><option value="english">US units</option><option value="metric">Metric</option></select></label>
      <label>Time <select id="display-zone" aria-label="Time"><option value="local">Your local time</option><option value="station" disabled>Station local time</option><option value="utc">UTC</option></select></label>
    </div>
    <label class="live-updates"><input id="live-updates" type="checkbox" checked aria-describedby="live-update-status"> Live updates</label>
    <button id="refresh-report" type="button">Refresh now</button>
    <p id="live-update-status" class="muted">Live updates every 6 minutes while this tab is visible.</p>
    <p id="report-status" role="status" aria-live="polite"></p>
    <button id="retry-report" type="button" hidden>Retry station data</button>
    <div id="station-summary"></div>
    <details id="historical-explorer">
      <summary>Explore historical dates &amp; export CSV</summary>
      <h2>Historical water levels</h2>
      <p class="muted">Investigate a storm or compare seasons. These fixed dates are separate from current conditions and future planning. Start/end dates include the whole UTC day.</p>
      <form id="history-form" class="history-form">
        <label for="history-start">Start date (UTC)</label>
        <input id="history-start" type="date" required min="1800-01-01">
        <label for="history-end">End date (UTC)</label>
        <input id="history-end" type="date" required min="1800-01-01">
        <label for="history-resolution">Historical resolution</label>
        <select id="history-resolution" aria-describedby="history-help">
          <option value="auto">Automatic</option>
          <option value="six_minute">Six-minute (up to 30 days)</option>
          <option value="hourly">Verified hourly (up to 365 days)</option>
          <option value="monthly">Verified monthly means (up to 200 years)</option>
        </select>
        <button type="submit">Load historical data</button>
        <button id="history-export" type="button" disabled>Export historical CSV</button>
      </form>
      <p id="history-help" class="muted">Automatic uses six-minute, hourly, then monthly data as the range grows. Verified data can lag recent months. Monthly values represent full calendar months and use NOAA's MSL field relative to the stated datum; they are not storm peaks or individual tides. Availability varies by station.</p>
      <p id="history-status" role="status" aria-live="polite">Choose dates and load historical data.</p>
      <div id="history-results" aria-busy="false">
        <p id="history-caption" class="muted"></p>
        <div id="history-chart" aria-label="Historical water-level chart"></div>
        <div id="history-difference-chart" aria-label="Historical observed-minus-predicted chart"></div>
        <details id="history-table" hidden><summary>View historical measurements as a table</summary><div class="table-scroll"><table><caption id="history-table-caption"></caption><thead><tr><th scope="col">Time / month</th><th scope="col">Product</th><th scope="col">Value</th><th scope="col">Quality / flags</th></tr></thead><tbody id="history-rows"></tbody></table></div><p id="history-page" class="muted"></p><button id="history-more" type="button" hidden>Show more historical measurements</button></details>
      </div>
    </details>
    <div id="station-charts">
      <div id="graph-partial" aria-label="Water-level chart"></div>
      <section id="weather-charts" aria-label="Station weather history" hidden></section>
    </div>
    <section id="planning-charts" aria-label="Tide planning and differences"></section>
    <section id="station-context" aria-label="Forecasts and flood context"></section>
    <section id="nearby-buoys" aria-label="Nearby NOAA buoys"></section>
    <details id="observations-table"><summary>View measurements as a table</summary><div class="table-scroll"><table><caption>Station observations and predictions</caption><thead><tr><th scope="col">Time</th><th scope="col">Product</th><th scope="col">Value</th><th scope="col">Quality / event</th></tr></thead><tbody id="measurement-rows"></tbody></table></div><p id="measurement-page" class="muted"></p><button id="more-measurements" type="button" hidden>Show more measurements</button></details>
    <p><a id="noaa-station-link" target="_blank" rel="noopener noreferrer">View this station at NOAA</a> · <button id="share-station" type="button">Copy station link</button></p>
    <p class="muted">Source: NOAA CO-OPS. Demonstration only; not for navigation. Predictions and observations are different products.</p>
  </section>
  <noscript>JavaScript is needed for the interactive explorer. <a href="https://tidesandcurrents.noaa.gov/map/">Browse NOAA's station map.</a></noscript>
</main>
